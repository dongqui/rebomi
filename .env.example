# 로컬 개발용. `cp .env.example .env` 후 필요하면 고친다.
DATABASE_URL=postgres://rebomi:rebomi@localhost:5432/rebomi

# apps/api
PORT=3001
# 쉼표로 구분. 웹(3000)과 Chrome 확장이 같은 API를 쓴다.
# 확장 ID는 unpacked 로드 시 경로에서 생성되므로 chrome://extensions 에서 확인해
# `chrome-extension://<your-id>` 를 여기 덧붙인다.
CORS_ORIGINS=http://localhost:3000

# 인증 (docs/architecture.md §3). 값은 저장소에 넣지 않는다.
# 액세스 토큰 서명 키. 32자 이상의 난수. 없으면 API가 기동하지 않는다.
# 예: `openssl rand -base64 48`
AUTH_JWT_SECRET=
# 우리 앱의 OAuth 클라이언트 ID. 쉼표로 구분(웹·iOS·Android가 서로 다르다).
# 비어 있으면 API는 뜨지만 그 제공자의 로그인은 503이다.
GOOGLE_CLIENT_IDS=
# Apple은 Service ID(웹)와 앱 번들 ID(iOS).
APPLE_CLIENT_IDS=

# 각 클라이언트가 보는 API 주소. 없으면 기동 시 즉시 실패한다.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
VITE_API_BASE_URL=http://localhost:3001
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001

# apps/web 로그인 화면. 없으면 웹이 기동하지 않는다. 값은 저장소에 넣지 않는다.
# Google OAuth 웹 클라이언트 ID. GOOGLE_CLIENT_IDS 에도 같은 값이 들어 있어야 한다.
# Google Cloud 콘솔의 "승인된 JavaScript 원본"에 http://localhost:3000 을 넣는다.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Apple Service ID. APPLE_CLIENT_IDS 에도 같은 값이 들어 있어야 한다.
# Apple은 localhost를 받지 않는다 — 실제 로그인은 HTTPS 도메인과 Return URL(<오리진>/login) 등록이 필요하다.
NEXT_PUBLIC_APPLE_CLIENT_ID=
