# 로컬 개발용. `cp .env.example .env` 후 필요하면 고친다.
DATABASE_URL=postgres://rebomi:rebomi@localhost:5432/rebomi

# apps/api
PORT=3001
# 쉼표로 구분. 웹(3000)과 Chrome 확장이 같은 API를 쓴다.
# 확장 ID는 unpacked 로드 시 경로에서 생성되므로 chrome://extensions 에서 확인해
# `chrome-extension://<your-id>` 를 여기 덧붙인다.
CORS_ORIGINS=http://localhost:3000

# 각 클라이언트가 보는 API 주소. 없으면 기동 시 즉시 실패한다.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
VITE_API_BASE_URL=http://localhost:3001
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001
