{
  "extends": "@rebomi/config/tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "types": ["node", "vite/client"]
  },
  "include": ["src/**/*", "vite.config.ts", "manifest.config.ts"]
}
